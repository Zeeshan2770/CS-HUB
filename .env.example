# Copy to .env for local development. In Netlify: Site configuration -> Environment variables.
# Both values are PUBLIC by design (they ship to the browser). Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
